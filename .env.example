# =============================================================================
# FULLSCAN-QA Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real API keys.
# =============================================================================

# --- LLM Provider ---
# Options: "mistral_api" | "openai_compatible"
# - mistral_api: Uses the official Mistral AI SDK
# - openai_compatible: For university-hosted or local endpoints serving Mistral models
LLM_PROVIDER=openai_compatible

# --- API Keys ---
# Course broker group key. Never commit the real value.
MISTRAL_API_KEY=

# --- Endpoint Configuration ---
# Base URL for openai_compatible provider (e.g., http://localhost:8000/v1)
# Leave empty for mistral_api (uses official endpoint automatically)
LLM_BASE_URL=http://80.151.131.52:9839/v1

# --- Model Selection ---
# These are the only IDs accepted by the course broker.
PLANNER_MODEL=mistral-small-3-2
MAPPER_MODEL=ministral-3b-2512
VERIFIER_MODEL=mistral-small-3-2
ANSWER_MODEL=mistral-small-3-2

# --- Concurrency & Reliability ---
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=300
MAX_RETRIES=1

# --- Chunking ---
# Target size per chunk in approximate tokens (chars / 4)
CHUNK_TARGET_TOKENS=3000
# Overlap only used for forced token-based splits
CHUNK_OVERLAP_TOKENS=0

# --- Question Batching ---
# Number of questions processed per mapper call per chunk
QUESTION_BATCH_SIZE=8
# Consecutive compiled records sent per mapper request
RECORD_BATCH_SIZE=3
# Maximum source characters per mapper batch. Oversized records are processed
# alone, so this limit never drops document coverage.
RECORD_BATCH_MAX_CHARACTERS=18000

# --- Storage ---
DATA_DIR=./data

# --- Vision Fallback ---
# If true, low-text pages may be rendered and sent to a vision-capable
# allowed model for text extraction. Only works if the endpoint supports it.
ENABLE_VISION_FALLBACK=false

# --- Pipeline Mode ---
# Single production route
PIPELINE_MODE=ADAPTIVE_HIERARCHICAL

# Enforce the model families allowed by the capstone rules.
EVALUATION_MODE=true

# --- Submission ---
TEAM_NAME=
SUBMISSION_NOTES=Compiled document catalog, deterministic structured reduction, exhaustive coverage matrices, and evidence-grounded hierarchical synthesis.
