# Local development profile. Non-Mistral models produce policy warnings but run.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
PLANNER_MODEL=qwen2.5:7b
MAPPER_MODEL=qwen2.5:7b
ANSWER_MODEL=qwen2.5:7b
VERIFIER_MODEL=qwen2.5:7b
EVALUATION_MODE=false

MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT_SECONDS=600
MAX_RETRIES=2
CHUNK_TARGET_TOKENS=3000
CHUNK_OVERLAP_TOKENS=0
QUESTION_BATCH_SIZE=2
PIPELINE_MODE=FULLSCAN_OPERATOR
DATA_DIR=./data
