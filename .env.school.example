# Evaluation profile for the university Ollama-compatible endpoint.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://i-dasc-03.informatik.hs-ulm.de:26605
PLANNER_MODEL=mistral-small3.2:latest
MAPPER_MODEL=ministral-3:latest
ANSWER_MODEL=mistral-small3.2:latest
VERIFIER_MODEL=mistral-small3.2:latest
EVALUATION_MODE=true

MAX_CONCURRENT_REQUESTS=4
REQUEST_TIMEOUT_SECONDS=600
MAX_RETRIES=2
CHUNK_TARGET_TOKENS=3000
CHUNK_OVERLAP_TOKENS=0
QUESTION_BATCH_SIZE=2
RECORD_BATCH_SIZE=3
RECORD_BATCH_MAX_CHARACTERS=18000
PIPELINE_MODE=ADAPTIVE_HIERARCHICAL
DATA_DIR=./data
